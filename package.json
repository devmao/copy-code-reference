{
  "name": "copy-code-reference",
  "displayName": "Copy Code Reference",
  "description": "Copy file path and selected line range to clipboard (file:startLine-endLine)",
  "version": "0.1.0",
  "publisher": "devmao",
  "repository": {
    "type": "git",
    "url": "https://github.com/devmao/copy-code-reference.git"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copyCodeReference.copy",
        "title": "Copy Code Reference (file:startLine-endLine)",
        "icon": "$(references)"
      }
    ],
    "keybindings": [
      {
        "command": "copyCodeReference.copy",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ -w"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.0.0"
  }
}
